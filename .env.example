# Template for .env.local. Committed on purpose: it documents which variables
# the app needs without carrying any values. See CLAUDE.md section 11.
#
# Copy to .env.local and fill in. Never put real values in this file.
#
#   cp .env.example .env.local

# Supabase: dashboard, Project Settings, Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Google Cloud Console, YouTube Data API v3, restricted key.
YOUTUBE_API_KEY=
